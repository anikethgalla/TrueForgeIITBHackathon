{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run TrueForge Coding Agent Extension (on pallets/flask 3.1.3)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}/benchmark-repos/flask",
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "env": {
        "NODE_OPTIONS": "--no-experimental-network-inspection"
      },
      "preLaunchTask": "${defaultBuildTask}"
    }
  ]
}

